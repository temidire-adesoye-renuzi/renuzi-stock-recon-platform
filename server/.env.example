# Storage mode: mock (local Excel file, default) or live (Microsoft Graph).
# Live mode REQUIRES all AZURE_*/GRAPH_* vars below — the server fails fast otherwise.
GRAPH_MODE=mock
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# OneDrive drive id + workbook file item id (live mode only).
GRAPH_DRIVE_ID=
GRAPH_FILE_ITEM_ID=
# Mock-mode workbook location (default: server/data/master_workbook.xlsx).
# MASTER_WORKBOOK_PATH=
JWT_SECRET=
TZ=Africa/Lagos
CUTOFF_HOUR=18
VARIANCE_NOTE_THRESHOLD=10
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
