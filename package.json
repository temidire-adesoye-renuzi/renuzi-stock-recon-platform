{
  "name": "renuzi-stock-recon-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Automated Stock Reconciliation & Variance Platform for Renuzi Ventures",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  }
}
